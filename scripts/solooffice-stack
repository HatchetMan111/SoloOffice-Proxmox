#!/usr/bin/env bash
#
# solooffice-stack - kleiner Wrapper um docker compose für SoloOffice.
#
set -euo pipefail

APP_DIR="/opt/solooffice"
ENV_FILE="${APP_DIR}/.env.solooffice"
COMPOSE_FILE="${APP_DIR}/docker-compose.yml"
CONFIG_FILE="/etc/solooffice/config.env"
VERSION_FILE="/etc/solooffice/version"

die() { printf '\033[1;31m[FAIL]\033[0m %s\n' "$*" >&2; exit 1; }

[[ -f "$COMPOSE_FILE" ]] || die "Fehlt: ${COMPOSE_FILE}"
[[ -f "$ENV_FILE" ]] || die "Fehlt: ${ENV_FILE} (solooffice-env ausführen)"

APP_PORT=8080
if [[ -r "$CONFIG_FILE" ]]; then
  APP_PORT="$(sed -n 's/^APP_PORT=//p' "$CONFIG_FILE" | tail -n 1)"
  APP_PORT="${APP_PORT%\"}"
  APP_PORT="${APP_PORT#\"}"
  APP_PORT="${APP_PORT%\'}"
  APP_PORT="${APP_PORT#\'}"
  [[ "$APP_PORT" =~ ^[0-9]+$ ]] || APP_PORT=8080
fi

if [[ -r "$VERSION_FILE" ]]; then
  SOLOOFFICE_VERSION="$(sed -n 's/^SOLOOFFICE_VERSION=//p' "$VERSION_FILE" | tail -n 1)"
  SOLOOFFICE_COMMIT_SHA="$(sed -n 's/^SOLOOFFICE_COMMIT_SHA=//p' "$VERSION_FILE" | tail -n 1)"
  export SOLOOFFICE_VERSION SOLOOFFICE_COMMIT_SHA
fi

cd "$APP_DIR"

compose() {
  docker compose --env-file "$ENV_FILE" -f "$COMPOSE_FILE" "$@"
}

backend_ready() {
  compose exec -T backend node -e \
    "fetch('http://127.0.0.1:3001/health/ready').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))" \
    >/dev/null 2>&1
}

frontend_ready() {
  curl -fsS --max-time 5 "http://127.0.0.1:${APP_PORT}/healthz" >/dev/null 2>&1
}

diagnostics() {
  echo "--- docker compose ps ---"
  compose ps -a 2>&1 || true
  echo "--- docker compose logs (letzte 200 Zeilen) ---"
  compose logs --no-color --tail=200 2>&1 || true
  echo "--- Container-Health ---"
  docker ps -a --filter "name=solooffice-" --format '{{.Names}}\t{{.Status}}' 2>&1 || true
  echo "--- systemd solooffice ---"
  systemctl status solooffice --no-pager -l 2>&1 || true
  echo "--- journalctl -u solooffice ---"
  journalctl -u solooffice -n 200 --no-pager 2>&1 || true
  echo "--- Ports ---"
  ss -tlnp 2>&1 || true
  echo "--- Speicher ---"
  df -h / /var/lib/docker 2>&1 || true
  free -m 2>&1 || true
}

case "${1:-}" in
  up)
    exec docker compose --env-file "$ENV_FILE" -f "$COMPOSE_FILE" up --remove-orphans
    ;;
  down)
    compose down --remove-orphans
    ;;
  build)
    compose build --pull
    ;;
  verify)
    for _ in $(seq 1 90); do
      if frontend_ready && backend_ready; then
        printf '\033[1;32m[ OK ]\033[0m SoloOffice antwortet auf http://127.0.0.1:%s und Backend/Datenbank sind bereit.\n' "$APP_PORT"
        exit 0
      fi
      sleep 2
    done
    echo "SoloOffice wurde nicht rechtzeitig bereit." >&2
    diagnostics >&2
    exit 1
    ;;
  status|ps)
    compose ps -a
    ;;
  logs)
    compose logs --no-color --tail="${2:-200}"
    ;;
  backup)
    exec bash ./manage-instances.sh backup solooffice
    ;;
  env)
    exec /usr/local/bin/solooffice-env
    ;;
  *)
    cat >&2 <<EOF
Usage: solooffice-stack {up|down|build|verify|status|logs [N]|backup|env}
EOF
    exit 2
    ;;
esac
